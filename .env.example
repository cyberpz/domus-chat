# Copia in .env e compila. Mai committare .env.
# Backend LLM: qualsiasi endpoint OpenAI-compatible (llama.cpp server,
# local-llm-manager, Ollama /v1, LM Studio, ecc.)
UPSTREAM=http://127.0.0.1:1234
# Token del backend (opzionale). NOTA: il local-llm-manager lo vuole come
# query param ?api_key=; il proxy lo gestisce in automatico.
UPSTREAM_AUTH=
# Voce (opzionale): server Whisper/OpenAI-compatible per /api/stt. Vuoto = off.
STT_URL=
# Voce TTS edge-tts (Microsoft, richiede internet). default en-US-AriaNeural.
TTS_VOICE=en-US-AriaNeural
